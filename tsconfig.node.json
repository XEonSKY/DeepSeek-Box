{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "out/ts-node",
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@main/*": ["./src/main/*"],
            "@/*": ["./src/renderer/src/*"]
        }
    },
    "include": [
        "electron.vite.config.ts",
        "src/main/**/*",
        "src/preload/**/*",
        "src/shared/**/*"
    ]
}
