{
  "name": "deepseek-box",
  "productName": "DeepSeek Box",
  "version": "0.1.6-alpha-2",
  "description": "DeepSeek Box —— 基于 Electron + Vite + Vue3 + Element Plus 的桌面外壳",
  "license": "Apache-2.0",
  "author": "XEonSKY Studio",
  "main": "./out/main/index.js",
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true,
    "@electron/rebuild": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "reinstall": "node node_modules/electron/install.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:x64": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:x64": "npm run build && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.5",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "pinia": "^4.0.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.xeonsky.dsbox",
    "productName": "DeepSeek Box",
    "executableName": "dsbox",
    "publish": {
      "provider": "github",
      "owner": "XEonSKY",
      "repo": "DeepSeek-Box",
      "releaseType": "prerelease"
    },
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "DeepSeek-Box-${version}-win-${arch}-setup.${ext}",
      "shortcutName": "DeepSeek Box"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon-mac.png",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "artifactName": "DeepSeek-Box-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "dsbox"
    },
    "appImage": {
      "artifactName": "DeepSeek-Box-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  }
}
