{
    "name": "deepseek-box",
    "productName": "DeepSeek Box",
    "version": "0.1.6",
    "description": "DeepSeek Box —— 基于 Electron + Vite + Vue 3 + Element Plus 的桌面外壳",
    "license": "Apache-2.0",
    "author": "XEonSKY Studio",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "reinstall": "node node_modules/electron/install.js",
        "build": "electron-vite build",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win",
        "dist:win:x64": "npm run build && electron-builder --win --x64",
        "dist:win:arm64": "npm run build && electron-builder --win --arm64",
        "dist:mac": "npm run build && electron-builder --mac",
        "dist:linux": "npm run build && electron-builder --linux",
        "dist:linux:x64": "npm run build && electron-builder --linux --x64",
        "dist:linux:arm64": "npm run build && electron-builder --linux --arm64",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "npm run typecheck && npm run lint && npm run test",
        "docs:dev": "vitepress dev",
        "docs:build": "vitepress build",
        "docs:preview": "vitepress preview",
        "prepare": "node scripts/install-hooks.mjs"
    },
    "dependencies": {
        "defu": "^6.1.7",
        "electron-updater": "^6.8.9",
        "semver": "^7.8.5",
        "write-file-atomic": "^8.0.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@antdv-next/auto-import-resolver": "^1.2.0",
        "@antdv-next/icons": "^1.1.2",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.2",
        "@types/semver": "^7.8.0",
        "@types/write-file-atomic": "^4.0.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.1",
        "@vueuse/core": "^15.0.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "antdv-next": "^1.5.4",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "element-plus": "^2.14.6",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "pinia": "^4.0.3",
        "pretty-bytes": "^7.1.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^7.3.6",
        "vitepress": "^1.6.4",
        "vitest": "^5.0.1",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-i18n": "^11.4.12",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.11"
    },
    "allowScripts": {
        "electron": true,
        "esbuild": true,
        "electron-winstaller": true,
        "@electron/rebuild": true
    },
    "build": {
        "appId": "com.xeonsky.dsbox",
        "productName": "DeepSeek Box",
        "executableName": "dsbox",
        "directories": {
            "output": "dist",
            "buildResources": "resources"
        },
        "files": [
            "out/**",
            "resources/**",
            "!**/.vscode/*",
            "!src/*",
            "!electron.vite.config.{js,ts,mjs,cjs}",
            "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}"
        ],
        "publish": {
            "provider": "github",
            "owner": "XEonSKY",
            "repo": "DeepSeek-Box",
            "releaseType": "prerelease"
        },
        "win": {
            "icon": "resources/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "DeepSeek Box",
            "artifactName": "DeepSeek-Box-${version}-win-${arch}-setup.${ext}"
        },
        "mac": {
            "icon": "resources/icon-mac.png",
            "category": "public.app-category.developer-tools",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "dmg": {
            "artifactName": "DeepSeek-Box-${version}-mac-${arch}.${ext}"
        },
        "linux": {
            "icon": "resources/icon.png",
            "category": "Development",
            "executableName": "dsbox",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "appImage": {
            "artifactName": "DeepSeek-Box-${version}-linux-${arch}.${ext}"
        }
    }
}
