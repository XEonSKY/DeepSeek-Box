{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "outDir": "out/ts-web",
        "paths": {
            "@/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"],
            "@ext/*": ["./src/extensions/*"]
        }
    },
    "include": [
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/shared/**/*",
        "src/extensions/**/*.vue",
        "src/extensions/*.ts",
        "src/extensions/*/**/*.ts"
    ],
    "exclude": ["src/extensions/**/main.ts"]
}
